# Portfolio architecture, dark variant: the light diagram with the CRT tones of the site palette.
...@architecture

style.fill: "#0c0e12"

classes.green.style: {fill: "#090a0c"; stroke: "#00ff00"; font-color: "#00ff00"}
classes.amber.style: {fill: "#090a0c"; stroke: "#ffbf00"; font-color: "#ffbf00"}
classes.cyan.style: {fill: "#090a0c"; stroke: "#00ffff"; font-color: "#00ffff"}
classes.red.style: {fill: "#090a0c"; stroke: "#ff0000"; font-color: "#ff0000"}
classes.group-green.style: {fill: "#0c0e12"; stroke: "#00ff00"; font-color: "#00ff00"}
classes.group-amber.style: {fill: "#0c0e12"; stroke: "#ffbf00"; font-color: "#ffbf00"}
classes.group-cyan.style: {fill: "#0c0e12"; stroke: "#00ffff"; font-color: "#00ffff"}
classes.flow.style: {stroke: "#357d35"; font-color: "#4da64d"}
